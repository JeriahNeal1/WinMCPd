<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\WindowsPowerUserMcp.AppManagement\WindowsPowerUserMcp.AppManagement.csproj" />
    <ProjectReference Include="..\WindowsPowerUserMcp.Core\WindowsPowerUserMcp.Core.csproj" />
    <ProjectReference Include="..\WindowsPowerUserMcp.Security\WindowsPowerUserMcp.Security.csproj" />
    <ProjectReference Include="..\WindowsPowerUserMcp.Orchestration\WindowsPowerUserMcp.Orchestration.csproj" />
    <ProjectReference Include="..\WindowsPowerUserMcp.Windows\WindowsPowerUserMcp.Windows.csproj" />
    <ProjectReference Include="..\WindowsPowerUserMcp.BrokerService\WindowsPowerUserMcp.BrokerService.csproj" />
    <ProjectReference Include="..\WindowsPowerUserMcp.StdioBridge\WindowsPowerUserMcp.StdioBridge.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.8" />
    <PackageReference Include="ModelContextProtocol" Version="1.3.0" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.3.0" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <StartupObject>WindowsPowerUserMcp.App.Program</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <NoWarn>$(NoWarn);NU1510;WFO0003</NoWarn>
  </PropertyGroup>

</Project>
