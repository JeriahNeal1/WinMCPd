{
  "TargetFrameworkPreference": "net10.0",
  "StdioEnabled": true,
  "LocalHttpEnabled": false,
  "LocalHttpPort": 49321,
  "IpcPipeName": "WindowsPowerUserMcp.Broker",
  "IpcCurrentUserOnly": true,
  "IpcAllowedUserSids": [],
  "IpcAllowBuiltinAdministrators": false,
  "DataRoot": "",
  "ServiceDataRoot": "",
  "LogRoot": "",
  "SqlitePath": "",
  "DefaultTimeoutSeconds": 300,
  "MaxStdoutCaptureBytes": 65536,
  "MaxStderrCaptureBytes": 65536,
  "SaveFullProcessLogs": true,
  "RedactEnvironmentVariables": true,
  "RedactSecretPatterns": [
    "password",
    "passwd",
    "pwd",
    "secret",
    "token",
    "api[_-]?key",
    "authorization",
    "cookie"
  ],
  "ShellEnabled": true,
  "UiAutomationEnabled": true,
  "ScreenshotsEnabled": true,
  "DesktopAgentRequiredForUi": true,
  "GenericShellRequiresElevatedForAdminTasks": true,
  "PackageInstallEnabled": true,
  "ServiceControlEnabled": true,
  "RegistryWriteEnabled": true,
  "ScheduledTaskEnabled": true,
  "AutostartEnabled": true,
  "TrayEnabled": true,
  "TaskContinuationsEnabled": true,
  "FilesystemWatchersEnabled": true,
  "OptionalHttpAuthRequired": true,
  "BlockedCredentialOperations": [
    "credential_dumping",
    "browser_password_extraction",
    "cookie_extraction",
    "token_theft",
    "mfa_bypass"
  ]
}
